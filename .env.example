# ==============================================================================
# NyaySetu Environment Variables Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or .env files to source control.
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Secrets (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Google Gemini API key (primary LLM provider)
# Model: gemini-2.5-flash (fast, large context window, great for legal docs)
# Get a key at: https://aistudio.google.com/app/apikey
# New key format (2025+) starts with a different prefix — copy exactly as shown in AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model without redeploying
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API key — fallback LLM provider
# Model: google/gemini-2.0-flash-001 (stable, fast, multimodal OCR + reasoning)
# Free alternative: google/gemini-2.0-flash-exp:free
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the OpenRouter model (defaults to google/gemini-2.0-flash-001)
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ------------------------------------------------------------------------------
# 2. Application & Security Configuration
# ------------------------------------------------------------------------------
# Node runtime environment (development, test, production)
NODE_ENV=development

# Session storage rolling TTL in minutes (default: 30 minutes)
SESSION_TTL_MINUTES=30

# Maximum allowed upload payload size in megabytes (default: 10MB)
MAX_UPLOAD_SIZE_MB=10

# Base URL for production deployments (used for canonical URLs and CORS)
# NEXT_PUBLIC_APP_URL=https://nyaysetu.gov.in
